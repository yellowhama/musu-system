# Copy to .env and fill before `docker compose up`.

# --- Ollama ---
# Model name as exposed by ollama list. Tiny models are good for dev/triage;
# bump for production. Auto-pull with: docker compose exec ollama ollama pull <name>
OLLAMA_CHAT_MODEL=llama3.2:1b

# --- nurikun mailbox provider ---
# gmail (OAuth, recommended) or imap (host/port/user/pass — add NURIKUN_IMAP_* below)
NURIKUN_MAILBOX_PROVIDER=gmail

# --- nurikun knowledge source ---
# none | folder | crawlai
NURIKUN_KNOWLEDGE_SOURCE=none
# NURIKUN_KNOWLEDGE_DIR=./projects-nurikun/default/knowledge

# --- nurikun outbound identity (required for compliant campaigns) ---
NURIKUN_SENDER_NAME=Yellowhama
NURIKUN_SENDER_ADDRESS=ceo@yellowhama.com
NURIKUN_SENDER_PHYSICAL=Seoul, Korea

# --- nurikun unsubscribe HMAC secret (generate with: openssl rand -hex 32) ---
NURIKUN_UNSUB_SECRET=

# --- nurikun public base URL used in unsubscribe/confirm links ---
# In dev, the default http://localhost:8088 works for local testing.
# In production with the `tls` compose profile + Caddy, set to your real
# https URL (the same hostname configured in caddy/Caddyfile).
NURIKUN_PUBLIC_BASE_URL=http://localhost:8088

# --- Production image version pin (used by docker-compose.production.yml) ---
# Set to a tag pushed by .github/workflows/docker-publish.yml in each repo.
# Leave unset / "latest" for rolling.
# MUSU_VERSION=v0.3.0

# --- IMAP-mode-only (when NURIKUN_MAILBOX_PROVIDER=imap) ---
# NURIKUN_IMAP_HOST=imap.example.com
# NURIKUN_IMAP_PORT=993
# NURIKUN_IMAP_USER=
# NURIKUN_IMAP_PASS=
# NURIKUN_SMTP_HOST=smtp.example.com
# NURIKUN_SMTP_PORT=587
# NURIKUN_SMTP_USER=
# NURIKUN_SMTP_PASS=
# NURIKUN_SMTP_FROM=
